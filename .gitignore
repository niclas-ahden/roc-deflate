# Ignore generated binaries (with no extension) by default
*
!*.*
!*/

.direnv/
.envrc
generated-docs/

# Benchmark corpus (Silesia), downloaded on demand by benchmark/corpus.sh
benchmark/.corpus/

# The catch-alls above ignore extensionless files, but this one must ship
!LICENSE

# Decompression benchmark caches (streams + builds), regenerated on demand
benchmark/.streams/
benchmark/.build/
benchmark/.work/
